<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Order</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, sans-serif;
      background: #f0f4f8;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
      min-height: 100vh;
    }
    .container {
      background: #e8f0fe;
      border-radius: 12px;
      padding: 36px;
      width: 100%;
      max-width: 560px;
    }
    h1 {
      text-align: center;
      color: #1a73e8;
      font-size: 1.8rem;
      margin-bottom: 28px;
    }
    .card {
      background: #fff;
      border-radius: 10px;
      padding: 28px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    label {
      display: block;
      color: #1a73e8;
      font-weight: 700;
      margin-bottom: 8px;
    }
    input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d0d0d0;
      border-radius: 6px;
      font-size: 0.95rem;
      color: #333;
    }
    input:focus {
      outline: none;
      border-color: #1a73e8;
    }
    .btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      color: #fff;
      margin-bottom: 12px;
      text-align: center;
      display: block;
      text-decoration: none;
    }
    .btn-primary { background: #1a73e8; }
    .btn-primary:hover { background: #1558b0; }
    .btn-back { background: #f4b400; }
    .btn-back:hover { background: #d9a000; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Update Order</h1>
    <div class="card">
      <form action="/orders/update/<%= order._id %>" method="POST">
        <div class="form-group">
          <label for="customerName">Customer Name</label>
          <input type="text" id="customerName" name="customerName" value="<%= order.customerName %>" required />
        </div>
        <div class="form-group">
          <label for="productName">Product Name</label>
          <input type="text" id="productName" name="productName" value="<%= order.productName %>" required />
        </div>
        <div class="form-group">
          <label for="quantity">Quantity</label>
          <input type="number" id="quantity" name="quantity" value="<%= order.quantity %>" min="1" required />
        </div>
        <div class="form-group">
          <label for="orderDate">Order Date</label>
          <input type="date" id="orderDate" name="orderDate" value="<%= new Date(order.orderDate).toISOString().split('T')[0] %>" required />
        </div>
        <button type="submit" class="btn btn-primary">Update Order</button>
      </form>
      <a href="/orders" class="btn btn-back">Go Back</a>
    </div>
  </div>
</body>
</html>
