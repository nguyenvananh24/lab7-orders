<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - Product Orders</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, sans-serif;
      background: #f0f4f8;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }
    .card {
      background: #fff;
      border-radius: 12px;
      padding: 36px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 4px 16px rgba(26, 115, 232, 0.1);
    }
    h1 {
      text-align: center;
      color: #1a73e8;
      font-size: 1.8rem;
      margin-bottom: 24px;
    }
    .alert {
      padding: 12px 16px;
      border-radius: 6px;
      font-size: 0.9rem;
      margin-bottom: 18px;
    }
    .alert-error {
      background: #fde8e8;
      color: #c81e1e;
      border: 1px solid #f8b4b4;
    }
    .alert-success {
      background: #def7ec;
      color: #03543f;
      border: 1px solid #bcf0da;
    }
    .form-group {
      margin-bottom: 18px;
    }
    label {
      display: block;
      color: #1a73e8;
      font-weight: 700;
      margin-bottom: 8px;
      font-size: 0.9rem;
    }
    input {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #d0d0d0;
      border-radius: 6px;
      font-size: 0.95rem;
      color: #333;
    }
    input:focus {
      outline: none;
      border-color: #1a73e8;
      box-shadow: 0 0 0 3px rgba(26, 115, 232, 0.2);
    }
    .btn {
      width: 100%;
      padding: 12px;
      background: #1a73e8;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn:hover {
      background: #1557b0;
    }
    .footer-link {
      text-align: center;
      margin-top: 18px;
      font-size: 0.9rem;
      color: #666;
    }
    .footer-link a {
      color: #1a73e8;
      text-decoration: none;
      font-weight: 600;
    }
    .test-credentials {
      margin-top: 24px;
      padding: 14px;
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 6px;
      font-size: 0.85rem;
      color: #475569;
    }
    .test-credentials strong {
      color: #1e293b;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>Login to System</h1>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter username" required autofocus />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter password" required />
      </div>

      <button type="submit" class="btn">Sign In</button>
    </form>

    <div class="footer-link">
      Don't have an account? <a href="/register">Register here</a>
    </div>

    <div class="test-credentials">
      <div style="font-weight: bold; margin-bottom: 6px;">Test Accounts:</div>
      <div>Admin: <strong>admin</strong> / <strong>123456</strong></div>
      <div>Staff: <strong>staff</strong> / <strong>123456</strong></div>
    </div>
  </div>
</body>
</html>
