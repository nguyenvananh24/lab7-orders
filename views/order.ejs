<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Orders</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, sans-serif;
      background: #f0f4f8;
      display: flex;
      justify-content: center;
      padding: 40px 20px;
      min-height: 100vh;
    }
    .container {
      background: #e8f0fe;
      border-radius: 12px;
      padding: 36px;
      width: 100%;
      max-width: 900px;
    }
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid #cbd5e1;
      font-size: 0.95rem;
    }
    .user-info {
      color: #334155;
    }
    .user-badge {
      display: inline-block;
      padding: 3px 8px;
      background: #1a73e8;
      color: #fff;
      border-radius: 4px;
      font-size: 0.8rem;
      font-weight: bold;
      text-transform: uppercase;
      margin-left: 6px;
    }
    .btn-logout {
      background: #ef4444;
      color: #fff;
      padding: 6px 14px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
    }
    .btn-logout:hover {
      background: #dc2626;
    }
    h1 {
      text-align: center;
      color: #1a73e8;
      font-size: 2rem;
      margin-bottom: 28px;
    }
    .alert-error {
      background: #fde8e8;
      color: #c81e1e;
      border: 1px solid #f8b4b4;
      padding: 12px 16px;
      border-radius: 6px;
      margin-bottom: 20px;
      text-align: center;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead tr {
      background: #1a73e8;
      color: #fff;
    }
    thead th {
      padding: 12px 16px;
      text-align: left;
      font-weight: 600;
    }
    tbody tr {
      background: #fff;
      border-bottom: 1px solid #dce8fb;
    }
    tbody tr:hover { background: #f5f9ff; }
    tbody td {
      padding: 12px 16px;
      color: #333;
    }
    .btn {
      display: inline-block;
      padding: 6px 14px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      color: #fff;
    }
    .btn-update { background: #1a73e8; margin-right: 4px; }
    .btn-delete { background: #f4b400; }
    .btn-update:hover { background: #1558b0; }
    .btn-delete:hover { background: #d9a000; }
    .actions-cell { display: flex; align-items: center; gap: 4px; }
    .total-price { white-space: nowrap; }
    .create-btn-wrap {
      text-align: center;
      margin-top: 28px;
    }
    .btn-create {
      background: #1a73e8;
      color: #fff;
      padding: 12px 36px;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    .btn-create:hover { background: #1558b0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="top-bar">
      <div class="user-info">
        Logged in as: <strong><%= typeof user !== 'undefined' && user ? user.username : 'User' %></strong>
        <% if (typeof user !== 'undefined' && user && user.role) { %>
          <span class="user-badge"><%= user.role %></span>
        <% } %>
      </div>
      <div>
        <a href="/logout" class="btn-logout">Logout</a>
      </div>
    </div>

    <h1>Product Orders</h1>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-error"><%= error %></div>
    <% } %>

    <table>
      <thead>
        <tr>
          <th>Customer Name</th>
          <th>Product Name</th>
          <th>Quantity</th>
          <th>Order Date</th>
          <th>Total Price</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(order => { %>
        <tr>
          <td><%= order.customerName %></td>
          <td><%= order.productName %></td>
          <td><%= order.quantity %></td>
          <td><%= new Date(order.orderDate).toLocaleDateString('en-US') %></td>
          <td class="actions-cell">
            <a href="/orders/update/<%= order._id %>" class="btn btn-update">Update</a>
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
            <form action="/orders/delete/<%= order._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this order?');">
              <button type="submit" class="btn btn-delete">Delete</button>
            </form>
            <% } %>
            <span class="total-price" style="margin-left:6px;"><%= order.totalPrice.toLocaleString() %> VND</span>
          </td>
        </tr>
        <% }) %>
        <% if (orders.length === 0) { %>
        <tr><td colspan="5" style="text-align:center;padding:20px;color:#888;">No orders found.</td></tr>
        <% } %>
      </tbody>
    </table>
    <div class="create-btn-wrap">
      <a href="/orders/create" class="btn-create">Create New Order</a>
    </div>
  </div>
</body>
</html>
